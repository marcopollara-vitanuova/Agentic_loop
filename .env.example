# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# The Anthropic SDK resolves credentials itself; no code in this repository
# reads or handles the secret value. Alternatively, run `ant auth login` and
# set nothing here.
ANTHROPIC_API_KEY=

# Optional: interpreter the TypeScript wrapper spawns (default: python3).
AGENTIC_LOOP_PYTHON=

# Optional: interpreter the TypeScript test fixtures use (default: python3).
AGENTIC_LOOP_TEST_PYTHON=
